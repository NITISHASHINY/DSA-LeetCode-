class Solution {
public:
    int findMaxFork(Node* root, int k) {

        int floor = -1;

        while (root != NULL) {

            if (root->data == k)
                return root->data;

            if (root->data < k) {
                floor = root->data;
                root = root->right;
            }
            else {
                root = root->left;
            }
        }

        return floor;
    }
};
