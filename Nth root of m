class Solution {
  public:
  
    int power(int mid, int n, int m) {
        long long res = 1;
        
        for(int i = 0; i < n; i++) {
            res *= mid;
            
            if(res > m) return 2; // too large
        }
        
        if(res == m) return 1; // equal
        return 0; // smaller
    }
  
    int nthRoot(int n, int m) {
        if(n == 1) return m;
        int low = 1, high = m;
        
        while(low <= high) {
            int mid = low + (high - low) / 2; // safer
            
            int val = power(mid, n, m);
            
            if(val == 1) return mid;
            else if(val == 0) low = mid + 1;
            else high = mid - 1;
        }
        
        return -1;
    }
};
