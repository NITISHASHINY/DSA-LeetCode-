class Solution {
  public:
   
   
    bool visited(int i, int j, int n,
            vector<vector<int>>& maze,
            vector<vector<int>>& visitedd) {

        if (i >= 0 && j >= 0 && i < n && j < n && maze[i][j] == 1 &&visitedd[i][j] == 0) {
            return true;
        }

        return false;
    }
    vector<string> ans;//move to class level
    string ch = " ";
  
    void solve(vector<vector<int>>& maze, int i, int j, vector<vector<int>>& visitedd, int n){
        if (i == n - 1 && j == n - 1) {
            ans.push_back(ch);
            return;
        }
        visitedd[i][j] = 1;
        // Down
        if (visited(i + 1, j, n, maze, visitedd)) {
            ch.push_back('D');
            solve(maze, i + 1, j, visitedd, n);
            ch.pop_back();
        }
        
        // Left
        if (visited(i, j - 1, n, maze, visitedd)) {
            ch.push_back('L');
            solve(maze, i, j - 1, visitedd, n);
            ch.pop_back();
        }
        
        // Right
        if (visited(i, j + 1, n, maze, visitedd)) {
            ch.push_back('R');
            solve(maze, i, j + 1, visitedd, n);
            ch.pop_back();
        }

        // Up
        if (visited(i - 1, j, n, maze, visitedd)) {
            ch.push_back('U');
            solve(maze, i - 1, j, visitedd, n);
            ch.pop_back();
        }
        visitedd[i][j] = 0; // backtrack
    }    
        
  
  
    vector<string> ratInMaze(vector<vector<int>>& maze){
        int n = maze.size();

        vector<vector<int>> visitedd(n, vector<int>(n, 0));

        if (maze[0][0] == 1)
            solve(maze, 0, 0, visitedd, n);

        sort(ans.begin(), ans.end());
        return ans;
    }
};
