class Solution {

  public:
    vector<int> help_classmate(vector<int> arr, int n) {
        vector<int> ans;
        for(int i = 0;i<n;i++){
            int found = 0;
            for(int j=i+1;j<n;j++){
                if(arr[j] < arr[i]){
                    ans.push_back(arr[j]);
                    found = 1;
                    break;
                }
                
            }
            if(found == 0){
                ans.push_back(-1);
            }    
            
        }
        return ans;
    
        
            
        
        
    }
};
