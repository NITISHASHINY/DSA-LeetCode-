class Solution {
  public:
    int ans;
    int count = 0;
    void inorder(Node* root , int k){
        if(root == NULL){
            return;
        }
        inorder(root->right , k);
        count++;
        if(count == k){
            ans = root->data;
            return;
            
        }
        inorder(root->left , k);
        
        
    }
    
    int kthLargest(Node *root, int k) {
        inorder(root , k);
        return ans;
    
        
    }
};
